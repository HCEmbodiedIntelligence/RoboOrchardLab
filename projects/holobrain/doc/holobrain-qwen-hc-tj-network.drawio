<mxfile host="65bd71144e">
    <diagram id="holobrain-hc-tj" name="HoloBrain Qwen HC-TJ">
        <mxGraphModel dx="1356" dy="1189" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="HoloBrain（config_holobrain_qwen_hc_tj.py）功能分层与训练状态" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" parent="1" vertex="1">
                    <mxGeometry x="230" y="20" width="1190" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="6 个功能层级；括号内为配置中的重复深度。绿色 = 参数参与训练，灰色 = 冻结，蓝色 = 无可训练参数/数据流" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#4B5563;" parent="1" vertex="1">
                    <mxGeometry x="300" y="65" width="1050" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="input_rgb" value="RGB 多相机图像\n+ 文本指令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="162.5" width="150" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="input_depth" value="深度图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="30" y="455" width="150" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="input_state" value="历史机器人状态\n14-DoF × 8维" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="682.5" width="150" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="layer1" value="第 1 层：数据预处理\nTextTemplate + Qwen AutoProcessor\n图像归一化 / token 化 / depth GT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="250" y="137.5" width="230" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="layer2" value="第 2 层：Qwen2.5-VL 多模态骨干（冻结）\nVision Encoder + Token Embedding\nLanguage Model：仅保留前 1 个 Transformer 层\n全部 vlm.*：requires_grad=False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#6B7280;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="540" y="122.5" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="mapping" value="跨层特征映射（可训练）\nfeat_mapping[0..1]：Linear(hidden→256)\nweight：2 个层权重，经 softmax 融合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="910" y="135" width="270" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="layer3" value="第 3 层：3D 深度特征骨干（可训练）\nSwinTransformer，3 stages\ndepths = [2, 6, 2]，heads = [2, 4, 8]\n输出 128 维深度特征" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="240" y="415" width="280" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="layer4" value="第 4 层：空间增强（可训练）\nDepthFusionSpatialEnhancer\nnum_depth_layers = 2\n融合 2D VLM 特征 + 3D 深度特征\n并计算 depth loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="650" y="405" width="300" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="layer5" value="第 5 层：机器人状态编码器（可训练）\nInput MLP → 256维\n编码块 ×4：Joint Graph Attention + FFN\n每块含 RMSNorm；末尾再 1 个 RMSNorm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="240" y="642.5" width="310" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="noise" value="训练时：GT action 加噪\nDDPM timestep + ScalarEmbedder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="650" y="790" width="250" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="layer6" value="第 6 层：扩散动作解码器（可训练）\nAction Input MLP + Decoder Block ×6\n每块：Temporal Joint Attention → Image Cross Attention\n→ Text Cross Attention → FFN（含 Norm / Gate / AdaRMSNorm）\n输出头：UpsampleHead ×2，16 chunks → 32 → 64 steps\n输出：14 joints × 8维状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="610" width="390" height="215" as="geometry"/>
                </mxCell>
                <mxCell id="loss" value="训练损失\nAction Smooth-L1\n+ Depth Loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="672.5" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="优化器：AdamW。所有非 vlm.* 参数进入参数组；真正发生梯度更新的是 requires_grad=True 的参数。冻结的 vlm.* 不进入优化器。基础学习率 1e-4，warmup 300 steps，余弦衰减到 2.5e-6。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;spacingLeft=12;" parent="1" vertex="1">
                    <mxGeometry x="300" y="900" width="1050" height="80" as="geometry"/>
                </mxCell>
