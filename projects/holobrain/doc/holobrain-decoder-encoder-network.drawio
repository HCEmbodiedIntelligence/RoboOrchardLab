                <mxCell id="sub" value="train()/eval() 决定分支；共用第 3 页网络；Qwen 默认训练扩为 4B、推理去噪 10 步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=7;" vertex="1" parent="1">
                    <mxGeometry x="40" y="95" width="1450" height="55" as="geometry"/>
