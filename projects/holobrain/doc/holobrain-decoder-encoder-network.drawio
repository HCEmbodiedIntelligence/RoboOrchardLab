                <mxCell id="tr2" value="&lt;b&gt;随机时间步 t&lt;/b&gt;&lt;br&gt;DDPM 1000 步中抽取&lt;br&gt;真值 + 噪声" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=7;" vertex="1" parent="1">
